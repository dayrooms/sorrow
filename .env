# ─────────────────────────────────────────────
#  Sorrow — environment configuration
#  Copy this file to ".env" and fill in the values.
#  NEVER commit your real .env to GitHub.
# ─────────────────────────────────────────────

# REQUIRED — from the Discord Developer Portal (Bot tab)
TOKEN=MTEyOTg1NTEzMjMxNDY0ODY5Nw.GbTtbB.c6UcSXZHKjumcJOmNgEEa8d0bnCZ8VdQ9D8n3Q

# REQUIRED — your application/client ID (General Information tab)
CLIENT_ID=your-client-id-here

# The bot owner(s). Comma-separated Discord user IDs. These users get
# full access to ;dev commands and bypass ALL permission checks everywhere.
OWNER_IDS=1116052806428786850

# Default prefix used when a server has not set its own. (Customizable per server.)
DEFAULT_PREFIX=;

# ─────────────────────────────────────────────
#  OPTIONAL — features degrade gracefully if unset
# ─────────────────────────────────────────────

# For the ;weather command — free key from https://openweathermap.org/api
OPENWEATHER_API_KEY=

# For the ;ask / AI commands — one of these (OpenAI-compatible or Anthropic)
AI_API_KEY=
AI_PROVIDER=openai          # openai | anthropic
AI_MODEL=gpt-4o-mini

# Lavalink (music). Leave MUSIC_ENABLED=false until you host Lavalink.
MUSIC_ENABLED=false
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
